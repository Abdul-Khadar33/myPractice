import java.util.*;
public class Main
    {
        public static void main(String args[])
        {
            Scanner sc = new Scanner(System.in);
            int n = sc.nextInt();
            int arr[] = new int[n];
            for(int i = 0; i < n; i++)
                {
                    arr[i] = sc.nextInt();
                }
            int maxSum = arr[0];
            int currSum = arr[0];
            for(int i = 1; i < n; i++)
                {
                    currSum = Math.max(arr[i], arr[i] + currSum);
                    maxSum = Math.max(currSum, maxSum);
                }
            System.out.println(maxSum);
        }
    }
