import java.util.*;
public class Main
    {
        public static void main(String args[])
        {
            Scanner sc = new Scanner(System.in);
            int n = sc.nextInt();
            int arr[] = new int[n];
            for(int i = 0; i < n; i++)
                {
                    arr[i] = sc.nextInt();
                }
            int k = sc.nextInt();
            int count = 0;
            for(int i = 0; i < n; i++)
                {
                    for(int j = i+1; j < n; j++)
                        {
                            int max = Math.max(arr[i], arr[j]);
                            int min = Math.min(arr[i], arr[j]);
                            if(max - min < k)
                            {
                                count++;
                            }
                        }
                }
            System.out.println(count);
        }
    }
