import java.util.*;
public class Main
    {
        public static void main(String args[])
        {
            Scanner sc = new Scanner(System.in);
            int n = sc.nextInt();
            int maxSum = sc.nextInt();
            int arr[] = new int[n];
            for(int i = 0; i < n; i++)
                {
                    arr[i] = sc.nextInt();
                }
            int left = 0;
            int leftIndex = -1;
            int rightIndex = -1;
            int start = 0;
            int sum = 0;
            int max = 0;
            for(int right = 0; right < n; right++)
                {
                    sum += arr[right];
                    if(sum > maxSum)
                    {
                        sum -= arr[left++];
                    }
                    int len = right-left+1;
                    if(len > max)
                    {
                        max = len;
                        leftIndex = left;
                        rightIndex = right;
                    }
                }
            System.out.println(max + " " + leftIndex + " " + rightIndex);
        }
    }
