import java.util.*;
public class Main
    {
        public static void main(String args[])
        {
            Scanner sc = new Scanner(System.in);
            int a = 0;
            int b = 1;
            int limit = sc.nextInt();
            for(int i = 0; i < limit; i++)
                {
                    System.out.print(a + " ");
                    int c = a + b;
                    a = b;
                    b = c;
                }
        }
    }
